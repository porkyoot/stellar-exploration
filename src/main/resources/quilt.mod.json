{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.stellar",
    "id": "stellar_exploration",
    "version": "1.0.0",
    "metadata": {
      "name": "Stellar Exploration",
      "description": "Client-side exploration framework and navigation enhancement mod for Minecraft",
      "icon": "assets/stellar_exploration/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client": {
        "adapter": "kotlin",
        "value": "com.stellar.exploration.StellarExplorationMod"
      },
      "modmenu": {
        "adapter": "kotlin",
        "value": "com.stellar.exploration.config.StellarExplorationModMenu"
      }
    },
    "depends": [
      {
        "id": "modmenu",
        "versions": "*",
        "optional": true
      }
    ]
  },
  "mixin": "stellar_exploration.mixins.json"
}
